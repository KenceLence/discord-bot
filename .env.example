# ---- Discord ----
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_id_here
GUILD_ID=your_server_id_here

# ---- Ticket system ----
# Optional — /ticket setup creates these for you and saves their IDs
TICKET_CATEGORY_ID=
TICKET_CLOSED_CATEGORY_ID=
TICKET_LOG_CHANNEL_ID=
# 0 = delete the ticket channel immediately on close, >0 = archive it for N minutes
TICKET_ARCHIVE_MINUTES=0

TICKET_SUPPORT_ROLE_ID=
TICKET_MAX_OPEN_PER_USER=3
TICKET_AUTO_CLOSE_HOURS=48

# ---- Abuse prevention ----
TICKET_COOLDOWN_MINUTES=10
TICKET_MAX_STRIKES=3
TICKET_STRIKE_WINDOW_MINUTES=60
# Closing faster than this with no staff reply = a strike
TICKET_STRIKE_UNDER_MINUTES=2

# Live open-tickets dashboard (created by /ticket live)
TICKET_LIVE_CHANNEL_ID=
# Staff alert channel (created by /ticket alerts)
TICKET_ALERT_CHANNEL_ID=
# Flag a ticket after this long with no staff reply, then escalate
TICKET_UNANSWERED_MINUTES=60
TICKET_UNANSWERED_ESCALATE_MINUTES=240

# ---- HTTP API (for your website) ----
# Bot will refuse ALL API requests if this is empty. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=
CORS_ORIGIN=https://yoursite.com
# PORT is set automatically by Railway — do not set it manually

# ---- Moderation ----
# Created by /modsetup — paste the printed ID here
MODLOG_CHANNEL_ID=
SPAM_MESSAGE_LIMIT=6
SPAM_WINDOW_SECONDS=8
SPAM_TIMEOUT_MINUTES=10

# ---- Staff ranks (lowest -> highest). Comma-separate multiple roles per rank ----
RANK_MODERATOR_ROLE_ID=
RANK_ADMIN_ROLE_ID=
RANK_OWNER_ROLE_ID=

# ---- Welcome ----
WELCOME_CHANNEL_ID=
WELCOME_ROLE_ID=

# ---- AI / website bridge ----
AI_API_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini